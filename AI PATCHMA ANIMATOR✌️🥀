end)

UIS.InputBegan:Connect(function(inp, proc)
	if proc or (inp.UserInputType ~= Enum.UserInputType.Touch and inp.UserInputType ~= Enum.UserInputType.MouseButton1) then return end
	local cam = Workspace.CurrentCamera
	if not character or not cam then return end
	local ray = cam:ScreenPointToRay(inp.Position.X, inp.Position.Y)
	local params = RaycastParams.new()
	params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Include, {character}
	local res = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	if not res or not res.Instance:IsA("BasePart") then return end
	outline.Adornee = res.Instance
	local acc = res.Instance:FindFirstAncestorOfClass("Accessory")
	if acc then
		local aj = acc:FindFirstChildWhichIsA("Weld", true) or acc:FindFirstChildWhichIsA("Motor6D", true)
		if aj then local cn = acc.Name:gsub("%s+", "") .. "Joint" setupJointEntry(cn, aj, aj.C0, aj.C1) openEditorForKey(cn) end
	else
		local jn = PART_TO_JOINT[res.Instance.Name]
		local j = jn and findJointInCharacter(character, jn)
		if j then setupJointEntry(jn, j, DEFAULT_OFFSETS[jn].C0, DEFAULT_OFFSETS[jn].C1) openEditorForKey(jn) end
	end
end)

