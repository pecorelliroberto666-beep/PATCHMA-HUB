local function fmtNum(n) local r = math.floor(n * 100000 + 0.5) / 100000 return tostring(r == -0 and 0 or r) end
local function buildAxisExpr(b, amp, spd)
	if amp == 0 then return fmtNum(b) end
	local term = fmtNum(math.abs(amp)) .. " * sin(sine * " .. fmtNum(spd) .. ")"
	return b == 0 and ((amp < 0 and "-" or "") .. term) or (fmtNum(b) .. (amp >= 0 and " + " or " - ") .. term)
end

local function formatCFrameWithSin(jName, pName, d, baseCF)
	local sCF = baseCF * CFrame.new(d.pos) * CFrame.Angles(math.rad(d.rot.X), math.rad(d.rot.Y), math.rad(d.rot.Z))
	local bx, by, bz = sCF.X, sCF.Y, sCF.Z
	local brx, bry, brz = sCF:ToEulerAnglesXYZ()
	local wSin = baseCF:VectorToWorldSpace(d.sinPos)
	local sRx, sRy, sRz = math.rad(d.sinRot.X), math.rad(d.sinRot.Y), math.rad(d.sinRot.Z)
	if pName == "C1" then bx, by, bz, wSin, sRx, sRy, sRz = baseCF.X, baseCF.Y, baseCF.Z, Vector3.new(), 0, 0, 0 brx, bry, brz = baseCF:ToEulerAnglesXYZ() end
	local pStr = string.format("cf(%s, %s, %s)", buildAxisExpr(bx, wSin.X, d.sinPosSpeed), buildAxisExpr(by, wSin.Y, d.sinPosSpeed), buildAxisExpr(bz, wSin.Z, d.sinPosSpeed))
	local aStr = string.format("angles(%s, %s, %s)", buildAxisExpr(brx, sRx, d.sinRotSpeed), buildAxisExpr(bry, sRy, d.sinRotSpeed), buildAxisExpr(brz, sRz, d.sinRotSpeed))
	return string.format("%s.%s = Lerp(%s.%s, cfMul(%s, %s), deltaTime)", jName, pName, jName, pName, pStr, aStr)
end

