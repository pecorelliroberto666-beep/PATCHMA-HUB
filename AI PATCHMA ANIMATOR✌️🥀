local function createControlRow(lblTxt, pType, ax, step)
	local l = Instance.new("TextLabel")
	l.Size, l.Position, l.BackgroundTransparency, l.Font, l.TextSize, l.TextColor3, l.TextXAlignment, l.Text, l.Parent = UDim2.new(0, 95, 0, 24), UDim2.new(0, 4, 0, currentY), 1, Enum.Font.Code, 12, Color3.fromRGB(220,220,220), Enum.TextXAlignment.Left, lblTxt, editorScroll
	local mBtn = makeSquaredButton(editorScroll, "-", UDim2.new(0, 28, 0, 24), UDim2.new(0, 102, 0, currentY))
	local vBox = Instance.new("TextBox")
	vBox.Size, vBox.Position, vBox.BackgroundColor3, vBox.BorderSizePixel, vBox.Font, vBox.TextSize, vBox.TextColor3, vBox.Text, vBox.ClearTextOnFocus, vBox.Parent = UDim2.new(0, 96, 0, 24), UDim2.new(0, 134, 0, currentY), Color3.fromRGB(18,18,18), 0, Enum.Font.Code, 12, Color3.fromRGB(255,255,255), "0", false, editorScroll
	local bSt = Instance.new("UIStroke") bSt.Thickness, bSt.ApplyStrokeMode, bSt.Parent = 1, Enum.ApplyStrokeMode.Border, vBox registerRGBStroke(bSt)
	local pBtn = makeSquaredButton(editorScroll, "+", UDim2.new(0, 28, 0, 24), UDim2.new(0, 234, 0, currentY))
	valueBoxes[pType .. (ax and ("_"..ax) or "")] = vBox

	local function upd(del, dir)
		if not currentJointKey or not jointsData[currentJointKey] then return end
		local d = jointsData[currentJointKey]
		if ax then
			local v = d[pType]
			local nv = math.floor(((dir ~= nil and dir or (v[ax] + del)) * 1000) + 0.5) / 1000
			d[pType] = Vector3.new(ax=="X" and nv or v.X, ax=="Y" and nv or v.Y, ax=="Z" and nv or v.Z)
			vBox.Text = tostring(nv)
		else
			local nv = math.floor(((dir ~= nil and dir or (d[pType] + del)) * 1000) + 0.5) / 1000
			d[pType] = nv vBox.Text = tostring(nv)
		end
	end
	mBtn.MouseButton1Click:Connect(function() upd(-step, nil) end)
	pBtn.MouseButton1Click:Connect(function() upd(step, nil) end)
	vBox.FocusLost:Connect(function()
		local n = tonumber(vBox.Text)
		if n then upd(0, n) elseif currentJointKey and jointsData[currentJointKey] then local d = jointsData[currentJointKey] vBox.Text = tostring(ax and d[pType][ax] or d[pType]) end
	end)
	currentY = currentY + 28
end

