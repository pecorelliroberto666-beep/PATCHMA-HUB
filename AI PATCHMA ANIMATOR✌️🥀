local function findJointInCharacter(char, jName)
	for _, d in ipairs(char:GetDescendants()) do
		if (d:IsA("Motor6D") or d:IsA("Weld")) and d.Name == jName then return d end
	end
end

local function setupJointEntry(key, jInst, c0, c1)
	if not jointsData[key] then
		jointsData[key] = {
			joint = jInst, baseC0 = c0 or (jInst and jInst.C0) or CFrame.new(), baseC1 = c1 or (jInst and jInst.C1) or CFrame.new(),
			pos = Vector3.new(), rot = Vector3.new(), sinPos = Vector3.new(), sinRot = Vector3.new(), sinPosSpeed = 2, sinRotSpeed = 3
		}
	else
		jointsData[key].joint = jInst
	end
	return jointsData[key]
end

local function getAnimatedOffset(d, t)
	local sP, sR = math.sin(t * d.sinPosSpeed), math.sin(t * d.sinRotSpeed)
	return CFrame.new(d.pos + d.sinPos * sP) * CFrame.Angles(math.rad(d.rot.X + d.sinRot.X * sR), math.rad(d.rot.Y + d.sinRot.Y * sR), math.rad(d.rot.Z + d.sinRot.Z * sR))
end

local function initCharacterJoints(char)
	jointsData = {}
	for jName, off in pairs(DEFAULT_OFFSETS) do
		local j = findJointInCharacter(char, jName)
		if j then j.C0, j.C1 = off.C0, off.C1 setupJointEntry(jName, j, off.C0, off.C1) end
	end
end

initCharacterJoints(character)

RunService.Stepped:Connect(function(_, dt)
	sine = sine + dt
	if not freezeAnimations then return end
	for _, d in pairs(jointsData) do if d.joint and d.joint.Parent then d.joint.C0 = d.baseC0 * getAnimatedOffset(d, sine) end end
end)
